{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Dominus",
  "version": "0.1.0",
  "identifier": "com.aj7developments.dominus",
  "build": {
    "frontendDist": "../src",
    "beforeDevCommand": "npm run shared",
    "beforeBuildCommand": "npm run shared"
  },
  "app": {
    "windows": [
      {
        "title": "Dominus",
        "width": 1180,
        "height": 780,
        "minWidth": 900,
        "minHeight": 620,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
